# ============================================================
# KABUPORT 環境変数サンプル
# すべて未設定でもデモデータで完全動作する (モックファースト)。
# 各変数に「未設定ならどうなるか」を明記。
# ============================================================

# --- サイト基本 ---
# 未設定: http://localhost:3240 を使用 (canonical/hreflang/sitemapの絶対URL基点)
NEXT_PUBLIC_SITE_URL=http://localhost:3240
NEXT_PUBLIC_SITE_NAME=KABUPORT
NEXT_PUBLIC_DEFAULT_LOCALE=ja

# --- Supabase / DB (Phase5以降) ---
# 未設定: 認証・ポートフォリオ等はデモ(インメモリ)動作。本番公開時は必須。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# --- 株価データプロバイダー ---
# 未設定 or "mock": src/data/*.json のサンプル株価を使用 (DataSourceBadge=Sample Data)。
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# --- 企業データプロバイダー ---
# 未設定 or "mock": サンプル企業情報を使用。
COMPANY_DATA_PROVIDER=mock
COMPANY_DATA_API_URL=
COMPANY_DATA_API_KEY=

# --- 適時開示プロバイダー (TDnet/EDINET連携先) ---
# 未設定 or "mock": サンプル開示を使用。
DISCLOSURE_DATA_PROVIDER=mock
DISCLOSURE_DATA_API_URL=
DISCLOSURE_DATA_API_KEY=

# --- ニュースプロバイダー ---
# 未設定 or "mock": サンプルニュースを使用。
NEWS_PROVIDER=mock
NEWS_API_URL=
NEWS_API_KEY=

# --- バッチ/Webhook (Phase8以降) ---
# 未設定: /api/cron 系は 401 を返し実行されない。
CRON_SECRET=
WEBHOOK_SECRET=

# --- メール (Resend, Phase5) ---
# 未設定: 認証メール送信はスキップされ、コンソールにリンクを出力。
RESEND_API_KEY=
EMAIL_FROM=noreply@kabuport.example

# --- 計測 / アフィリエイト ---
# 未設定: アナリティクスは無効。/go リダイレクトは署名なしで動作(本番は要設定)。
NEXT_PUBLIC_ANALYTICS_ID=
AFFILIATE_REDIRECT_SECRET=

# --- エラー監視 (Sentry) ---
# 未設定: Sentryは無効。
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
