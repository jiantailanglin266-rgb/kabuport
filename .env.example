# ============================================================
# KABUPORT 環境変数サンプル
# すべて未設定でもデモデータで完全動作する (モックファースト)。
# 各変数に「未設定ならどうなるか」を明記。
# ============================================================

# --- サイト基本 ---
# 未設定: http://localhost:3240 を使用 (canonical/hreflang/sitemapの絶対URL基点)
NEXT_PUBLIC_SITE_URL=http://localhost:3240
NEXT_PUBLIC_SITE_NAME=KABUPORT
NEXT_PUBLIC_DEFAULT_LOCALE=ja

# --- Supabase / DB (Phase5以降) ---
# 未設定: 認証・ポートフォリオ等はデモ(インメモリ)動作。本番公開時は必須。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# --- 株価データプロバイダー ---
# 未設定 or "mock": src/data/*.json のサンプル株価を使用 (DataSourceBadge=Sample Data)。
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# --- J-Quants API (日次の実データ取得。CI/GitHub Secrets に設定) ---
# いずれか設定すれば scripts/fetch-jquants.mjs が実データを src/data/live/jquants.json に書き出す。
# 未設定なら何もせず、サンプルデータのまま (画面は壊れない)。
# 推奨: リフレッシュトークン(約1週間有効)を登録。
JQUANTS_REFRESH_TOKEN=
# もしくはメール+パスワード (スクリプトがトークンを都度取得)
JQUANTS_MAILADDRESS=
JQUANTS_PASSWORD=
# 無料プランの配信遅延(分)。遅延バッジ表示用 (任意)。
JQUANTS_DELAY_MINUTES=

# --- 企業データプロバイダー ---
# 未設定 or "mock": サンプル企業情報を使用。
COMPANY_DATA_PROVIDER=mock
COMPANY_DATA_API_URL=
COMPANY_DATA_API_KEY=

# --- 適時開示プロバイダー (TDnet/EDINET連携先) ---
# 未設定 or "mock": サンプル開示を使用。
DISCLOSURE_DATA_PROVIDER=mock
DISCLOSURE_DATA_API_URL=
DISCLOSURE_DATA_API_KEY=

# --- YouTube (動画ライブラリ) ---
# 未設定: src/data/videos.json のモック動画を表示（埋め込み再生なし・「モック」と明示）。
# 設定時: scripts/fetch-youtube.mjs が実データを src/data/live/youtube.json に書き出し、
#         youtube-nocookie の埋め込みプレーヤーで再生されるようになる。
YOUTUBE_API_KEY=
# 任意: 収集対象チャンネル（カンマ区切り）。未設定なら YOUTUBE_QUERIES の検索で収集。
YOUTUBE_CHANNEL_IDS=
# 任意: 検索語（カンマ区切り）。未設定なら日本株関連の既定語を使用。
YOUTUBE_QUERIES=

# --- ニュースプロバイダー ---
# 未設定 or "mock": サンプルニュースを使用。
NEWS_PROVIDER=mock
NEWS_API_URL=
NEWS_API_KEY=

# --- RSSニュース取得 ---
# 未設定: デモデータ（架空企業のサンプル記事）を表示。
# 設定時: GitHub Actions が定期取得し public/data/news/*.json を生成する。
# ブラウザからは実行されない（APIキー・URLはサーバー側のみ）。
RSS_FEED_MARKET_1=
RSS_FEED_MARKET_2=
RSS_FEED_COMPANY_1=
RSS_FEED_ECONOMY_1=
RSS_FEED_DISCLOSURE_1=
# 各フィードの任意設定（例: RSS_FEED_MARKET_1_NAME=〇〇ニュース）
#   *_NAME  表示名 / *_SITE サイトURL / *_TRUST 信頼度(1-5)
#   *_IMAGE_OK=true       画像の利用条件を確認できた場合のみ true
#   *_COMMERCIAL_OK=true  商用利用が可能と確認できた場合のみ true
#   *_TERMS               規約メモ
# 取得時の安全上限（任意）
RSS_TIMEOUT_MS=15000
RSS_MAX_BYTES=3145728
RSS_MAX_ITEMS=50

# --- バッチ/Webhook (Phase8以降) ---
# 未設定: /api/cron 系は 401 を返し実行されない。
CRON_SECRET=
WEBHOOK_SECRET=

# --- メール (Resend, Phase5) ---
# 未設定: 認証メール送信はスキップされ、コンソールにリンクを出力。
RESEND_API_KEY=
EMAIL_FROM=noreply@kabuport.example

# --- 計測 / アフィリエイト ---
# 未設定: アナリティクスは無効。/go リダイレクトは署名なしで動作(本番は要設定)。
NEXT_PUBLIC_ANALYTICS_ID=
AFFILIATE_REDIRECT_SECRET=

# --- エラー監視 (Sentry) ---
# 未設定: Sentryは無効。
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
